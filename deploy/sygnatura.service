[Unit]
Description=Studio Sygnatura — serwis (gunicorn + Flask)
After=network.target

[Service]
User=sygnatura
Group=sygnatura
WorkingDirectory=/opt/sygnatura/repo/serwis
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sygnatura/venv/bin/gunicorn --workers 2 --threads 4 --bind 127.0.0.1:8000 --timeout 60 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
